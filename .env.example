# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/code-breakers?retryWrites=true&w=majority

# JWT signing secret (generate with: openssl rand -hex 64)
JWT_SECRET=replace_with_a_long_random_secret_string

# Express server port
PORT=5000

# One-time secret for the /api/admin/setup route to create the first admin account
ADMIN_SETUP_SECRET=replace_with_your_admin_setup_secret

# Frontend URL (for CORS whitelist)
CLIENT_URL=http://localhost:5173

# Set to true only if integrating Judge0 or a similar code execution API for Round 3 auto-grading
AUTO_GRADE_ENABLED=false

# Judge0 API (only needed if AUTO_GRADE_ENABLED=true)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_key_here
